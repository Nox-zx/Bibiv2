# Discord
DISCORD_TOKEN=

# Gemini: configure 1 to 4 independent API keys.
# The router automatically distributes requests and fails over on provider errors.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Backwards compatibility: if none of the numbered keys are set,
# GEMINI_API_KEY is used as a single-provider fallback.
GEMINI_API_KEY=

GUILD_ID=
CREATOR_ID=
COGNITIVE_MODEL=gemini-3.6-flash
REFLECTIVE_MODEL=gemini-3.5-flash-lite
COGNITIVE_THINKING=medium
REFLECTIVE_THINKING=low
DATABASE_URL=sqlite+aiosqlite:///./data/bibi.db
CONTEXT_MESSAGE_LIMIT=25
ATTENTION_MINUTES=20
REFLECTION_MINUTES=360
MAX_RESPONSE_LENGTH=1200
